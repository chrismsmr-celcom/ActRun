{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/chrismsmr-celcom/ActRun/schemas/event.v1.schema.json",
  "title": "ActRun Event",
  "description": "Immutable event recorded in the ActRun append-only log.",
  "type": "object",
  "required": ["event_id", "timestamp", "agent_id", "action", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique identifier for the event (e.g., UUID)",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of the event",
      "format": "date-time"
    },
    "agent_id": {
      "type": "string",
      "description": "Identifier of the agent that triggered the action"
    },
    "action": {
      "type": "string",
      "description": "The type of action (e.g., 'workspace.branch', 'workspace.commit', 'lease.acquire')",
      "enum": ["workspace.branch", "workspace.commit", "lease.acquire", "lease.release", "tool.call"]
    },
    "payload": {
      "type": "object",
      "description": "Action-specific data"
    },
    "metadata": {
      "type": "object",
      "description": "Optional context (e.g., trace_id, session_id)"
    }
  }
}
