# Copy to .env.local for local dev, or set these in your hosting provider (build-time variables).
# Leave ALL of them unset to run against a local API without authentication.

# Base URL of the deployed Cohort API (no trailing slash)
VITE_API_BASE_URL=https://your-cohort-api.onrender.com

# Supabase project (Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# UUID of the row in public.cohort_organizations that testers belong to
VITE_COHORT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

# Optional: shows a "Send feedback" link in the sidebar (mailto: or form URL)
VITE_FEEDBACK_URL=mailto:beta@your-domain.com
